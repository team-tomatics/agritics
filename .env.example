# cp .env.example .env 후 값 채우기. .env 는 커밋 금지 (CI 가 막음)

# 서빙
# local | mlflow
MODEL_SOURCE=mlflow
# lazy | eager (기획서 ② 응답 1초 → eager)
LOADING_MODE=eager

# 데이터 수집 (A)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
# 가락시장 반입물량 OpenAPI (승인 대기)
SEOUL_AGRO_API_KEY=

# LLM 사이드카 (10/1 결정: OpenAI · 실패 시 템플릿 보고서, 이슈 #14)
# 없으면 템플릿 보고서로 대체
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# 초 (기획서 3-2 "30초 초과" 기준)
LLM_TIMEOUT=30
ITEM_NAME=토마토
