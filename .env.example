# cp .env.example .env 후 값 채우기. .env 는 커밋 금지 (CI 가 막음)

# 서빙
MODEL_SOURCE=mlflow          # local | mlflow
LOADING_MODE=eager           # lazy | eager (기획서 ② 응답 1초 → eager)

# 데이터 수집 (A)
KAMIS_CERT_KEY=
KAMIS_CERT_ID=
SEOUL_AGRO_API_KEY=          # 가락시장 반입물량 OpenAPI (승인 대기)

# LLM 사이드카 (팀 결정 전 — 외부 API / 로컬 ollama)
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
